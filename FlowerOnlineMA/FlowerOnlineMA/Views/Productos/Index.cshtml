
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 mt-4">
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="m-0 font-weight-bold"><i class="fas fa-boxes me-2"></i>Catálogo de Productos</h5>
            <button type="button" class="btn btn-success btn-sm" onclick="abrirModal(null)">
                <i class="fas fa-plus me-1"></i> Nuevo Producto
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="tablaProductos" class="table table-striped table-bordered align-middle" style="width:100%">
                    <thead class="table-dark">
                        <tr>
                            <th>Imagen</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Categorías</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @*DataTables cargará los datos vía AJAX aquí*@
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@*Modal del Producto*@
<div class="modal fade" id="modalProducto" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="lblModalTitulo">Registrar Producto</h5>
                <button type="button" class="btn-close btn-close-white"data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formProducto" enctype="multipart/form-data">
                    <input type="hidden" id="textIdProducto" value="0"/>
                    <input type="hidden" id="txtRutaImagenActual" value=""/>

                    <div class="row g-3">
                        @*Vista Previa de Imagen*@
                        <div class="col-md-4 text-center">
                            <label class="form-label font-weight-bold">Vista Previa</label>
                            <div class="mb-2">
                                <img  id="imgPreview" src="~/Uploads/Productos/sin-imagen" class="img-thumbnail" style="max-height:180px; object-fit:cover" alt="Preview"/>
                            </div>
                            <input type="file" id="fileImagen" class="form-control form-control-sm" accept="image/*" onchange="mostrarImagenPreview(this)">
                        </div>

                        @*Campos del Producto*@
                        <div class="col-md-8">
                            <div class="mb-2">
                                <label for="txtNombre" class="form-label">Nombre del Producto</label>
                                <input type="text" id="txtNombre" class="form-control form-control-sm" required />
                            </div>
                            <div class="mb-2">
                                <label for="cboCategoria" class="form-label">Categoria</label>
                                <select id="cboCategoria" class="form-select form-select-sm" required>
                                    <option>>-- Seleccione --<</option>
                                </select>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="txtPrecio" class="form-label">Precio (S/)</label>
                                    <input type="number" id="txtPrecio" class="form-control form-control-sm" step="0.01" min="0.10" required />
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="txtStock" class="form-label">Stock</label>
                                    <input type="number" id="txtStock" class="form-control form-control-sm" min="0" required />
                                </div>
                            </div>
                            <div class="mb-2">
                                <label for="txtDescripcion" class="form-label">Descripcion</label>
                                <textarea id="txtDescripcion" class="form-control form-control-sm" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss>Cancelar</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="guardar()">Guardar Producto</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        var tablaData;

        $(document).ready(function () {
            //Cargar el Select de Categorías
            cargarCategorias();

            //Inicializar DataTables
            tablaData = $('#tablaProductos').DataTable({
                responsive: true,
                ordering: true,
                "ajax": {
                    "url": '@Url.Action("ListarProductos", "Productos")',
                    "type": "GET",
                    "dataType": "json"
                },
                "columns": [
                    {
                        "data": "RutaImagen", "render": function (data) {
                            var ruta = data ? data : '/Uploads/Productos/sin-imagen.jpg';
                            return '<img src="' + ruta + '" class="rounded" style="width:50px; height:50px; object-fit:cover;" />';
                        }
                    },
                    { "data": "Nombre" },
                    { "data": "Descripcion" },
                    { "data": "NombreCategoria" },
                    {
                        "data": "Precio", "render": function (data) {
                            return 'S/ ' + parseFloat(data).toFixed(2);
                        }
                    },
                    { "data": "Stock" },
                    {
                        "data": "IdProducto", "render": function (data, type, row) {
                            return '<button type="button" class="btn btn-primary btn-sm me-1 btn-editar"><i class="fas fa-pen"></i></button>' +
                                '<button type="button" class="btn btn-danger btn-sm btn-eliminar"><i class="fas fa-trash"></i></button>';
                        },
                        "orderable": false,
                        "searchable": false,
                        "width": "90px"
                    }
                ],
                "languague": {
                    "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                }
            });
        });

        //Carga de las categorías en el Select
        function cargarCategorias() {
            jQuery.ajax({
                url: '@Url.Action("ListarCategorias", "Productos")',
                type: "GET",
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    $("#cboCategoria").html('<option value="">-- Seleccione --</option>');
                    $.each(data.data, function (index, item) {
                        if (item.Estado) {
                            $("<option>").val(item.IdCategoria).text(item.Nombre).appendTo("#cboCategoria");
                        }
                    });
                }
            });
        }

        //Mostrar previsualización de a imagen seleccionada en el input
        function mostrarImagenPreview(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#imgPreview').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        //Abre el modal para Crear o Editar
        function abrirModal(json) {
            $("#txtIdProducto").val(0);
            $("#txtRutaImagenActual").val("");
            $("#imgPreview").attr("src", "/Uploads/Productos/sin-imagen.jpg");
            $("#fileImagen").val("");
            $("#txtNombre").val("");
            $("#cboCategoria").val("");
            $("#txtPrecio").val("");
            $("#txtStock").val("");
            $("#txtDescripcion").val("");

            if (json != null) {
                $("#lblModalTitulo").text("Editar Producto");
                $("#txtIdProducto").val(json.IdProducto);
                $("#txtRutaImagenActual").val(json.RutaImagen);
                $("#imgPreview").attr("src", json.RutaImagen ? json.RutaImagen : "/Uploads/Productos/sin-imagen.jpg");
                $("#txtNombre").val(json.Nombre);
                $("#cboCategoria").val(json.IdCategoria);
                $("#txtPrecio").val(json.Precio);
                $("#txtStock").val(json.Stock);
                $("#txtDescripcion").val(json.Descripcion);
            } else {
                $("#lblModalTitulo").text("Registrar Producto");
            }

            $('#modalProducto').modal('show');
        }

        // Click en Botón Editar de la tabla
        $('#tablaProductos tbody').on('click', '.btn-editar', function () {
            var filaSeleccionada = $(this).closest('tr');
            var data = tablaData.row(filaSeleccionada).data();
            abrirModal(data);
        });

        // Guardar mediante AJAX + FormData
        function guardar() {
            var fileInput = $("#fileImagen")[0].files[0];

            var formData = new FormData();
            formData.append("producto.IdProducto", $("#txtIdProducto").val());
            formData.append("producto.Nombre", $("#txtNombre").val());
            formData.append("producto.IdCategoria", $("#cboCategoria").val());
            formData.append("producto.Precio", $("#txtPrecio").val());
            formData.append("producto.Stock", $("#txtStock").val());
            formData.append("producto.Descripcion", $("#txtDescripcion").val());
            formData.append("producto.RutaImagen", $("#txtRutaImagenActual").val());

            // Adjuntar archivo binario si seleccionó uno nuevo
            if (fileInput) {
                formData.append("imagenFile", fileInput);
            }

            jQuery.ajax({
                url: '@Url.Action("GuardarProducto", "Productos")',
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.resultado) {
                        tablaData.ajax.reload();
                        $('#modalProducto').modal('hide');
                        Swal.fire('¡Éxito!', data.mensaje || 'Operación realizada correctamente.', 'success');
                    } else {
                        Swal.fire('Atención', data.mensaje, 'warning');
                    }
                },
                error: function (error) {
                    Swal.fire('Error', 'No se pudo procesar la solicitud.', 'error');
                }
            });
        }

        // Click en Botón Eliminar
        $('#tablaProductos tbody').on('click', '.btn-eliminar', function () {
            var filaSeleccionada = $(this).closest('tr');
            var data = tablaData.row(filaSeleccionada).data();

            Swal.fire({
                title: '¿Está seguro?',
                text: "Desea eliminar el producto: " + data.Nombre,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    jQuery.ajax({
                        url: '@Url.Action("EliminarProducto", "Productos")',
                        type: "POST",
                        data: JSON.stringify({ IdProducto: data.IdProducto }),
                        dataType: "json",
                        contentType: "application/json; charset=utf-8",
                        success: function (data) {
                            if (data.resultado) {
                                tablaData.ajax.reload();
                                Swal.fire('¡Eliminado!', 'El producto ha sido eliminado.', 'success');
                            } else {
                                Swal.fire('Error', data.mensaje, 'error');
                            }
                        }
                    });
                }
            });
        });
    </script>
    }